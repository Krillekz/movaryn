# ─────────────────────────────────────────────────────────────
# Movaryn — provider configuration
#
# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored and is read only by the local API server.
# Keys are never sent to the browser.
# ─────────────────────────────────────────────────────────────

# Port for the local API server (Vite proxies /api here in development).
PORT=8787

# ── Chat provider ───────────────────────────────────────────
# Any OpenAI-compatible endpoint: OpenAI, Azure OpenAI gateway,
# OpenRouter, Together, the Freebuff API, or a local server.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-your-key
AI_MODEL=gpt-4.1-mini

# Set to false when your model cannot read image inputs.
AI_VISION=true

# Set to false when your provider cannot stream responses.
AI_STREAM=true

# ── Image provider ──────────────────────────────────────────
# Leave BASE/KEY empty to reuse the chat provider credentials.
IMAGE_BASE_URL=
IMAGE_API_KEY=
# Required for OpenAI-shaped hosts. Left empty, images report as unconfigured.
IMAGE_MODEL=gpt-image-1

# ── Cloudflare Workers AI (optional free image allowance) ───
# Free plan: 10,000 neurons/day (~50-200 FLUX images), resets 00:00 UTC.
# Setting the account id selects the cloudflare backend automatically.
# IMAGE_PROVIDER=cloudflare
# IMAGE_ACCOUNT_ID=your-cloudflare-account-id
# IMAGE_API_KEY=your-api-token-with-workers-ai-access
# IMAGE_MODEL defaults to @cf/black-forest-labs/flux-1-schnell

# low | medium | high | auto (optional, sent only when set)
IMAGE_QUALITY=

# Force one size such as 1024x1024. Leave empty to follow the
# aspect ratio chosen in the app.
IMAGE_SIZE=

# Allow an uploaded reference image to be sent to /images/edits.
# Set to false for providers that only expose /images/generations.
IMAGE_REFERENCE=true

# ── Frontend build ──────────────────────────────────────────
# Only needed when the frontend is hosted separately from the API
# (for example GitHub Pages). This value is PUBLIC — never put a
# key here. Leave empty for same-origin deployments.
# VITE_API_BASE_URL=https://your-movaryn-api.example.com

# ── HTTP access ─────────────────────────────────────────────
# Comma-separated origins allowed to call the API cross-origin.
# Leave empty for same-origin only. Use "null" for file:// builds.
ALLOWED_ORIGINS=
